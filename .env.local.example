# Copy this file to .env.local and fill in the three values.

# Supabase → Project Settings → API (or "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Comic Vine → https://comicvine.gamespot.com/api/ (sign in, then copy your key)
# Server-only: never prefix this with NEXT_PUBLIC_
COMICVINE_API_KEY=your-comic-vine-key
